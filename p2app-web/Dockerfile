FROM node:24-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

FROM node:24-alpine AS builder
WORKDIR /app

# Variáveis NEXT_PUBLIC_* são embutidas no bundle durante o build.
# Valores vazios caem nos padrões definidos em src/config/branding.ts e src/lib/auth.ts.
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_SHORT_NAME
ARG NEXT_PUBLIC_APP_TAGLINE
ARG NEXT_PUBLIC_APP_DESCRIPTION
ARG NEXT_PUBLIC_APP_SUBTITLE
ARG NEXT_PUBLIC_APP_HERO_TITLE
ARG NEXT_PUBLIC_APP_HERO_BODY
ARG NEXT_PUBLIC_AUTH_BADGE
ARG NEXT_PUBLIC_DEMO_LABEL
ARG NEXT_PUBLIC_DEMO_DESCRIPTION
ARG NEXT_PUBLIC_TRUST_ITEMS
ARG NEXT_PUBLIC_ACCENT_COLOR
ARG NEXT_PUBLIC_BG_DEEP
ARG NEXT_PUBLIC_BG_CARD
ARG NEXT_PUBLIC_BG_ACCENT
ARG NEXT_PUBLIC_AUTH_TOKEN_KEY
ARG NEXT_PUBLIC_AUTH_USER_KEY
ARG NEXT_PUBLIC_AUTH_EVENT
ARG NEXT_PUBLIC_AUTH_CHANNEL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME} \
    NEXT_PUBLIC_APP_SHORT_NAME=${NEXT_PUBLIC_APP_SHORT_NAME} \
    NEXT_PUBLIC_APP_TAGLINE=${NEXT_PUBLIC_APP_TAGLINE} \
    NEXT_PUBLIC_APP_DESCRIPTION=${NEXT_PUBLIC_APP_DESCRIPTION} \
    NEXT_PUBLIC_APP_SUBTITLE=${NEXT_PUBLIC_APP_SUBTITLE} \
    NEXT_PUBLIC_APP_HERO_TITLE=${NEXT_PUBLIC_APP_HERO_TITLE} \
    NEXT_PUBLIC_APP_HERO_BODY=${NEXT_PUBLIC_APP_HERO_BODY} \
    NEXT_PUBLIC_AUTH_BADGE=${NEXT_PUBLIC_AUTH_BADGE} \
    NEXT_PUBLIC_DEMO_LABEL=${NEXT_PUBLIC_DEMO_LABEL} \
    NEXT_PUBLIC_DEMO_DESCRIPTION=${NEXT_PUBLIC_DEMO_DESCRIPTION} \
    NEXT_PUBLIC_TRUST_ITEMS=${NEXT_PUBLIC_TRUST_ITEMS} \
    NEXT_PUBLIC_ACCENT_COLOR=${NEXT_PUBLIC_ACCENT_COLOR} \
    NEXT_PUBLIC_BG_DEEP=${NEXT_PUBLIC_BG_DEEP} \
    NEXT_PUBLIC_BG_CARD=${NEXT_PUBLIC_BG_CARD} \
    NEXT_PUBLIC_BG_ACCENT=${NEXT_PUBLIC_BG_ACCENT} \
    NEXT_PUBLIC_AUTH_TOKEN_KEY=${NEXT_PUBLIC_AUTH_TOKEN_KEY} \
    NEXT_PUBLIC_AUTH_USER_KEY=${NEXT_PUBLIC_AUTH_USER_KEY} \
    NEXT_PUBLIC_AUTH_EVENT=${NEXT_PUBLIC_AUTH_EVENT} \
    NEXT_PUBLIC_AUTH_CHANNEL=${NEXT_PUBLIC_AUTH_CHANNEL}
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["npm", "run", "start"]
