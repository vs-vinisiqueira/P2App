# =============================================================================
#  TEMPLATE DO FRONTEND — copiar para .env.local (dev) ou incluir no .env.production
# =============================================================================

# URL da API acessível pelo navegador. Em produção com nginx proxy, use /api
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Identidade -----
NEXT_PUBLIC_APP_NAME=P2App
NEXT_PUBLIC_APP_SHORT_NAME=P2
NEXT_PUBLIC_APP_TAGLINE=Helpdesk técnico
NEXT_PUBLIC_APP_DESCRIPTION=Gestão de chamados com autenticação JWT, controle de perfis e fluxo de atendimento.

# ----- Textos da landing page -----
NEXT_PUBLIC_APP_SUBTITLE=Sistema de gestão de chamados técnicos
NEXT_PUBLIC_APP_HERO_TITLE=Uma central de chamados enxuta para suporte técnico de verdade.
NEXT_PUBLIC_APP_HERO_BODY=Priorize incidentes, acompanhe status e mantenha o histórico do atendimento em uma interface clara.

# ----- Textos da tela de login -----
NEXT_PUBLIC_AUTH_BADGE=Operação com JWT, perfis e trilha de atendimento
NEXT_PUBLIC_DEMO_LABEL=Ambiente de demonstração
NEXT_PUBLIC_DEMO_DESCRIPTION=Dados sensíveis ficam fora da interface; a sessão usa token local e expira pelo backend.

# Trust items na sidebar do login.
# Formato: texto1|texto2|texto3   OU   JSON array: ["item1","item2","item3"]
NEXT_PUBLIC_TRUST_ITEMS=Perfis separados para cliente, técnico, gerente e administrador|Fila com prioridade, risco operacional e histórico do chamado|Experiência responsiva para triagem no desktop ou no celular

# ----- Cores -----
NEXT_PUBLIC_ACCENT_COLOR=#f6c43b
NEXT_PUBLIC_BG_DEEP=#07111f
NEXT_PUBLIC_BG_CARD=#0b1b2b
NEXT_PUBLIC_BG_ACCENT=#12365b

# ----- Chaves de sessão no localStorage -----
NEXT_PUBLIC_AUTH_TOKEN_KEY=app_token
NEXT_PUBLIC_AUTH_USER_KEY=app_user
NEXT_PUBLIC_AUTH_EVENT=app:auth-changed
NEXT_PUBLIC_AUTH_CHANNEL=app-auth
