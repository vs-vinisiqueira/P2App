# =============================================================================
#  TEMPLATE DE PRODUÇÃO — copiar para .env.production e preencher os valores
#  NÃO commitar .env.production no repositório
# =============================================================================

# -----------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------
POSTGRES_DB=p2app
POSTGRES_USER=p2app_app
POSTGRES_PASSWORD=TROQUE-POR-SENHA-FORTE-MIN-20-CHARS
# DATABASE_URL é montado automaticamente pelo docker-compose a partir das vars acima.
# Mantenha aqui como documentação/fallback local:
DATABASE_URL=postgresql://p2app_app:TROQUE-POR-SENHA-FORTE-MIN-20-CHARS@db:5432/p2app

# -----------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE-POR-CHAVE-ALEATORIA-64-HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------
# INFRAESTRUTURA
# -----------------------------------------------------------------------
DB_WAIT_TIMEOUT=60
API_ROOT_PATH=/api
HTTP_PORT=80

# IPs ou domínios que podem chamar a API — separar por vírgula
# Ex: http://192.168.1.50,https://chamados.empresa.com.br
CORS_ORIGINS=http://localhost,http://IP-DO-SERVIDOR

# -----------------------------------------------------------------------
# IDENTIDADE DO SISTEMA (backend)
# -----------------------------------------------------------------------
APP_NAME=P2App
APP_DESCRIPTION=Gestão de chamados técnicos

# -----------------------------------------------------------------------
# ADMIN INICIAL
# Executar após o primeiro "docker compose up":
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     exec api python scripts/create_admin.py
# -----------------------------------------------------------------------
APP_ADMIN_NAME=Administrador
# E-mail com domínio válido (não .local). Exemplo: admin@empresa.com.br
APP_ADMIN_EMAIL=admin@empresa.com.br
# Mínimo 12 caracteres. O responsável deve trocar no primeiro acesso.
APP_ADMIN_PASSWORD=TROQUE-ESTA-SENHA-MIN-12

# -----------------------------------------------------------------------
# FRONTEND — variáveis lidas pelo Next.js (prefixo NEXT_PUBLIC_)
# São embutidas no build — altere ANTES de "docker compose up --build"
# -----------------------------------------------------------------------

# URL da API acessível pelo navegador do usuário final
NEXT_PUBLIC_API_URL=/api

# ----- Identidade -----
NEXT_PUBLIC_APP_NAME=P2App
NEXT_PUBLIC_APP_SHORT_NAME=P2
NEXT_PUBLIC_APP_TAGLINE=Helpdesk técnico
NEXT_PUBLIC_APP_DESCRIPTION=Gestão de chamados com autenticação JWT, controle de perfis e fluxo de atendimento.

# ----- Textos da landing page -----
NEXT_PUBLIC_APP_SUBTITLE=Sistema de gestão de chamados técnicos
NEXT_PUBLIC_APP_HERO_TITLE=Uma central de chamados enxuta para suporte técnico de verdade.
NEXT_PUBLIC_APP_HERO_BODY=Priorize incidentes, acompanhe status e mantenha o histórico do atendimento em uma interface clara.

# ----- Textos da tela de login -----
NEXT_PUBLIC_AUTH_BADGE=Operação com JWT, perfis e trilha de atendimento
NEXT_PUBLIC_DEMO_LABEL=Ambiente de demonstração
NEXT_PUBLIC_DEMO_DESCRIPTION=Dados sensíveis ficam fora da interface; a sessão usa token local e expira pelo backend.

# Trust items na sidebar do login.
# Formato: texto1|texto2|texto3   OU   JSON array: ["item1","item2","item3"]
NEXT_PUBLIC_TRUST_ITEMS=Perfis separados para cliente, técnico, gerente e administrador|Fila com prioridade, risco operacional e histórico do chamado|Experiência responsiva para triagem no desktop ou no celular

# ----- Cores -----
# Cor de destaque (botões, ícones, badges). Exemplos: laranja=#f97316  azul=#3b82f6
NEXT_PUBLIC_ACCENT_COLOR=#f6c43b
# Fundo escuro principal (sidebar, dark mode, hero)
NEXT_PUBLIC_BG_DEEP=#07111f
# Fundo de cards no dark mode
NEXT_PUBLIC_BG_CARD=#0b1b2b
# Terceira cor para gradientes
NEXT_PUBLIC_BG_ACCENT=#12365b

# ----- Chaves de sessão no localStorage -----
# Alterar se o mesmo domínio hospedar outros sistemas, para evitar conflito.
NEXT_PUBLIC_AUTH_TOKEN_KEY=app_token
NEXT_PUBLIC_AUTH_USER_KEY=app_user
NEXT_PUBLIC_AUTH_EVENT=app:auth-changed
NEXT_PUBLIC_AUTH_CHANNEL=app-auth
